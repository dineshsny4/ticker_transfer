{
  "manifest_version": 3,
  "name": "Ticker Transfer",
  "version": "0.2.1",
  "description": "Move a stock watchlist between TradingView, Zerodha Kite and Dhan, with its sections.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Ticker Transfer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ticker-transfer@nifty.trading.tools",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
